  "lyrics": [
    { "time": 27.53, "text": "Er bestaat een wereld die maar enkelingen kennen" },
    { "time": 30.58, "text": "Bijna niemand heeft er in z'n leven van gehoord" },
    { "time": 33.76, "text": "Monsters die vandaar komen alleen om jou te jennen" },
    { "time": 37.23, "text": "Vinden allemaal de weg langs de magische poort" },
    { "time": 40.78, "text": "Maar gelukkig is er iemand die jou kan behoeden" },
    { "time": 44.28, "text": "Voor het kwaad dat uit dat universum hier verschijnt" },
    { "time": 47.75, "text": "Dat zijn wij maar weet wel dat er niemand zal vermoeden" },
    { "time": 51.17, "text": "Dat wij er voor zorgen dat het kwaad zomaar verdwijnt" },
    { "time": 56.26, "text": "Ad ad ad Inferos" },
    { "time": 59.85, "text": "Kijk daar is de Nachtwacht" },
    { "time": 63.06, "text": "Ad ad ad Inferos" },
    { "time": 66.53, "text": "Tijd voor toverij" },
    { "time": 69.9, "text": "Ad ad ad Inferos" },
    { "time": 73.64, "text": "Waken doet de Nachtwacht" },
    { "time": 76.86, "text": "Ad ad ad Inferos" },
    { "time": 80.34, "text": "Over jou en mij" },
    { "time": 101.28, "text": "Wezens waarvan niemand dacht dat ze ook echt bestonden" },
    { "time": 104.43, "text": "Zouden heel de wereld met hun kracht kunnen verslaan" },
    { "time": 107.33, "text": "Maar door wat we allemaal in Vega's boeken vonden" },
    { "time": 111.25, "text": "Gingen wij met drie toch alle uitdagingen aan" },
    { "time": 114.7, "text": "Want wat niemand ooit zou kunnen denken of verwachten" },
    { "time": 118.28, "text": "Diep in elk van ons schuilt er een wonderlijke held" },
    { "time": 121.47, "text": "Een vampier, een weerwolf en een elf met toverkrachten" },
    { "time": 124.82, "text": "Zorgen keer op keer dat ieder monster wordt geveld" },
    { "time": 129.84, "text": "Ad ad ad Inferos" },
    { "time": 133.32, "text": "Kijk daar is de Nachtwacht" },
    { "time": 136.62, "text": "Ad ad ad Inferos" },
    { "time": 140.29, "text": "Tijd voor toverij" },
    { "time": 143.41, "text": "Ad ad ad Inferos" },
    { "time": 147.23, "text": "Waken doet de Nachtwacht" },
    { "time": 150.78, "text": "Ad ad ad Inferos" },
    { "time": 153.96, "text": "Over jou en mij" },
    { "time": 157.33, "text": "Maar de wereld blijft alleen bespaard van die gevaren" },
    { "time": 165.23, "text": "Als we allemaal dit magische geheim bewaren" },
